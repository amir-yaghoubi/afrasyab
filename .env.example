# Telegram
TELEGRAM_BOT_TOKEN=
SUPER_ADMIN_TELEGRAM_ID=

# Google OAuth (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_BASE_URL=https://afrasyab.example.com

# 32-byte key: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# SQLite database (file created automatically; parent dir must exist or use data/)
DATABASE_URL=sqlite:data/afrasyab.db?mode=rwc

# Optional
HTTP_BIND=0.0.0.0:8080
RUST_LOG=info,afrasyab=debug
MAX_PLAYLIST_ITEMS=25
MAX_CONCURRENT_JOBS=4

# Max file size: direct HTTP download, yt-dlp, and Drive upload (default 2 GiB)
# MAX_FILE_BYTES=2147483648

# Production (Docker Compose + Traefik)
DOMAIN=afrasyab.example.com
ACME_EMAIL=you@example.com
TELEGRAM_MODE=polling
# Required when TELEGRAM_MODE=webhook (generate: openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=
